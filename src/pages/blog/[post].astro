---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getLocale, getTranslations } from '../../i18n/i18n';

const { post: slug } = Astro.params;

const allPosts = await getCollection('blog');
const post = allPosts.find((p) => p.id === slug);

if (!post) {
  return new Response(null, { status: 404 });
}

const locale = getLocale(Astro.url);
const t = getTranslations(Astro.url);

const { Content, headings } = await render(post);

function formatDate(date: Date, loc: string): string {
  return date.toLocaleDateString(loc === 'en' ? 'en-US' : 'es-CO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title={`${post.data.title} — Diego Betancourt`} description={post.data.excerpt}>
  <Navigation />

  <main id="post-main" class="relative z-10 max-w-[860px] mx-auto w-full px-6 sm:px-8 py-12 md:py-20 flex-grow">
    <article>
      <!-- Article header -->
      <header class="mb-10 pb-6 border-b border-[var(--border)]">
        <div class="flex items-center gap-2 font-mono text-[12px] text-[var(--text-dim)] mb-4">
          <a
            href={`/blog?lang=${locale}`}
            class="text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors no-underline"
          >
            ~/blog
          </a>
          <span class="text-[var(--text-faint)]">/</span>
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date, locale)}
          </time>
        </div>

        <h1 class="font-mono font-medium text-[clamp(26px,4vw,42px)] tracking-[-0.03em] text-[var(--text-bright)] mb-4 leading-[1.2]">
          {post.data.title}
        </h1>

        <div class="flex items-center gap-2 font-mono text-[12px] text-[var(--text-faint)]">
          <span>// {locale === 'en' ? 'author' : 'autor'}:</span>
          <span class="text-[var(--text-bright)]">{post.data.author}</span>
        </div>
      </header>

      <!-- Article body -->
      <div class="prose-editorial">
        <TableOfContents headings={headings} />
        <Content />
      </div>

      <!-- Article footer with back link -->
      <footer class="mt-16 pt-6 border-t border-[var(--border)]">
        <a
          href={`/blog?lang=${locale}`}
          class="inline-flex items-center gap-2 font-mono text-[13px] text-[var(--text-dim)] hover:text-[var(--accent)] transition-colors no-underline"
        >
          <span>←</span>
          <span data-i18n="backToBlog">
            {locale === 'en' ? 'Back to Blog' : 'Volver al Blog'}
          </span>
        </a>
      </footer>
    </article>
  </main>

  <Footer />
</Base>
