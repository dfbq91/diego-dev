---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Navigation from '../../components/Navigation.astro';
import BlogCard from '../../components/BlogCard.astro';
import Footer from '../../components/Footer.astro';
import { getLocale, getTranslations } from '../../i18n/i18n';

const t = getTranslations(Astro.url);
const locale = getLocale(Astro.url);

const allPosts = await getCollection('blog');
function getPostsForLocale(loc: 'es' | 'en') {
  return allPosts
    .filter((post) => post.data.lang === loc)
    .map((post) => ({
      id: post.id,
      title: post.data.title,
      date: post.data.date,
      excerpt: post.data.excerpt || post.body.slice(0, 150) + '...',
      slug: post.id,
      lang: post.data.lang,
    }))
    .sort((a, b) => b.date.valueOf() - a.date.valueOf());
}

const postsByLocale = { es: getPostsForLocale('es'), en: getPostsForLocale('en') };

function formatDate(date: Date, loc: string): string {
  return date.toLocaleDateString(loc === 'en' ? 'en-US' : 'es-CO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title={`${t.blog.title} — Diego Betancourt`} description={t.meta.description}>
  <Navigation />

  <main id="blog-main" class="relative z-10 max-w-[1000px] mx-auto w-full px-6 sm:px-8 py-12 md:py-20 flex-grow">
    <!-- Header -->
    <div class="flex items-baseline justify-between gap-6 mb-12 pb-5 border-b border-[var(--border)]">
      <div>
        <div class="font-mono text-[12px] text-[var(--text-dim)] tracking-[0.06em]">
          <span class="text-[var(--accent)] mr-2">07</span>{locale === 'en' ? 'WRITINGS & NOTES' : 'ESCRITOS Y NOTAS'}
        </div>
        <h1 class="font-mono font-medium text-[clamp(28px,3.5vw,40px)] tracking-[-0.03em] text-[var(--text-bright)] mt-2 mb-0" data-i18n="blog">
          {t.blog.title}
        </h1>
      </div>

      <div class="font-mono text-[12px] text-[var(--text-dim)] text-right hidden sm:block">
        ~/blog<br />
        <span class="text-[var(--accent)]">● {locale === 'en' ? 'published articles' : 'artículos publicados'}</span>
      </div>
    </div>

    <!-- Blog post listing -->
    {(['es', 'en'] as const).map((loc) => (
      <div data-language-content={loc} class="flex flex-col gap-4">
        {postsByLocale[loc].length > 0
          ? postsByLocale[loc].map((post) => (
              <BlogCard
                title={post.title}
                excerpt={post.excerpt}
                date={post.date}
                slug={post.slug}
                lang={loc}
                dateFormat={formatDate(post.date, loc)}
              />
            ))
          : (
            <p class="font-mono text-[14px] text-[var(--text-dim)] py-8 text-center border border-dashed border-[var(--border)] rounded-xl">
              {t.blog.noArticles}
            </p>
          )
        }
      </div>
    ))}
  </main>

  <Footer />
</Base>
